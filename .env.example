# ==============================================================================
# Secure User Authentication System - Root Environment Configuration Example
# Copy this file to .env (or backend/.env) before starting the server.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
# Local MongoDB instance:
MONGO_URI=mongodb://127.0.0.1:27017/secure_auth_system

# Ephemeral in-memory database fallback (development only; ignored in production)
# Set to 'true' if local MongoDB server is not running
USE_IN_MEMORY_DB=true

# JWT Configuration
# In production, generate a cryptographically strong 64-byte random hex string:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_strong_64_character_random_hex_secret_in_production
JWT_EXPIRES_IN=1h
JWT_ISSUER=secure-auth-system
JWT_AUDIENCE=secure-auth-client

# Cookie Configuration (HttpOnly session token)
COOKIE_NAME=auth_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Password Hashing Cost (bcrypt salt rounds; minimum 12 enforced by application)
BCRYPT_SALT_ROUNDS=12

# CORS & Brute-Force Rate Limiting
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
