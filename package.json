{
  "name": "secure-user-authentication-system",
  "version": "1.0.0",
  "description": "Production-structured User Authentication System (Node.js, Express, MongoDB/Mongoose, JWT HttpOnly Cookies, bcrypt) for Task 3",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:verbose": "jest --runInBand --verbose --forceExit",
    "verify": "node tests/manual-verify.js"
  },
  "keywords": [
    "authentication",
    "jwt",
    "bcrypt",
    "express",
    "mongodb",
    "mongoose",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "@netlify/database": "^2.0.3",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "serverless-http": "^4.0.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
