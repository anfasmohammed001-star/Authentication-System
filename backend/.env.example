# ==============================================================================
# Secure User Authentication System - Environment Configuration
# Copy this file to backend/.env (or .env at project root) before running.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
# Local MongoDB example: mongodb://127.0.0.1:27017/secure_auth_system
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/secure_auth_system
MONGO_URI=mongodb://127.0.0.1:27017/secure_auth_system

# Development-only fallback: set to true to run an ephemeral in-memory MongoDB
# instance if MongoDB is not installed locally (ignored in production).
USE_IN_MEMORY_DB=false

# JWT Configuration
# IMPORTANT: Generate a strong 64+ character random secret for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_strong_64_character_random_hex_secret_in_production
JWT_EXPIRES_IN=1h
JWT_ISSUER=secure-auth-system
JWT_AUDIENCE=secure-auth-client

# Cookie Configuration
COOKIE_NAME=auth_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Password Hashing (Minimum 12 salt rounds enforced by application config)
BCRYPT_SALT_ROUNDS=12

# CORS & Brute-Force Rate Limiting
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

